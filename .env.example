# Copy this to .env in the same directory (drop the .example) and fill in a key.
# .gitignore already blocks .env / .env.* / *.key.
#
# Running several models through OpenRouter (recommended): one key covers every
# vendor, and model names are written provider/model, e.g.
#   --model z-ai/glm-5.3-flash
OPENROUTER_API_KEY=

# Talking to a vendor directly (optional; used when the model name has no "/")
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
